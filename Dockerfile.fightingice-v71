FROM eclipse-temurin:21-jre-jammy

ARG GAME_URL=https://github.com/TeamFightingICE/FightingICE/releases/download/v7.1/DareFightingICE-7.1.zip
ARG GAME_SHA256=510752a69a097b767677d3911b1407d6a08a721dad4faf2cb5b7a19b988f1c62
ARG RESOURCE_URL=https://github.com/TeamFightingICE/FightingICE/releases/download/v7.1/resource-7.1.zip
ARG RESOURCE_SHA256=386fd713f901db00583054528ccfbce315953c157dc16231c4367416d86dce53

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    mkdir -p /tmp/fightingice/extract /opt/fightingice; \
    curl -fL --retry 3 -o /tmp/fightingice/game.zip "$GAME_URL"; \
    curl -fL --retry 3 -o /tmp/fightingice/resource.zip "$RESOURCE_URL"; \
    echo "$GAME_SHA256  /tmp/fightingice/game.zip" | sha256sum -c -; \
    echo "$RESOURCE_SHA256  /tmp/fightingice/resource.zip" | sha256sum -c -; \
    unzip -q /tmp/fightingice/game.zip -d /tmp/fightingice/extract; \
    jar_path="$(find /tmp/fightingice/extract -type f -name FightingICE.jar -print -quit)"; \
    test -n "$jar_path"; \
    game_dir="$(dirname "$jar_path")"; \
    cp -a "$game_dir"/. /opt/fightingice/; \
    unzip -q -o /tmp/fightingice/resource.zip -d /opt/fightingice; \
    test -f /opt/fightingice/FightingICE.jar; \
    rm -rf /tmp/fightingice

WORKDIR /opt/fightingice
EXPOSE 31415

ENTRYPOINT ["java", "-cp", "FightingICE.jar:./lib/*:./lib/lwjgl/*:./lib/lwjgl/natives/linux/amd64/*:./lib/grpc/*", "Main"]
CMD ["--headless-mode", "--pyftg-mode", "--input-sync", "--limithp", "400", "400", "--port", "31415"]
